# PostgreSQL settings used by the host-run NestJS backend.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=jungle_gaming
POSTGRES_USER=jungle
POSTGRES_PASSWORD=change-me
PORT=3000
# LocalStack endpoint and development-only credentials for the AWS SDK.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
