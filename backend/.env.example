# Configurações do PostgreSQL usadas pelo backend NestJS executado na máquina local.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=jungle_gaming
POSTGRES_USER=jungle
POSTGRES_PASSWORD=change-me
PORT=3000
# Endereço do LocalStack e credenciais exclusivas de desenvolvimento para o AWS SDK.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Optional override when the queue URL cannot be resolved from its name.
# WAGER_TRANSACTIONS_QUEUE_URL=
# WAGER_EVENTS_QUEUE_URL=
